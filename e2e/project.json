{
  "name": "trinity-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e",
  "tags": ["type:e2e", "scope:trinity"],
  "implicitDependencies": ["trinity"],
  "targets": {
    "e2e": {
      "//": "The support invocation owns dynamic app/report servers and the fixed-port Synapse stack; Playwright only joins it.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-playwright.mts --config=e2e/playwright.config.mts --build=trinity:build:development --resource=synapse",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "//": "Declared, not inferred: @nx/eslint only infers a lint target for projects with .ts/.js sources, and every file here is .mts — so removing 'e2e' from globalIgnores would otherwise have changed nothing about what `pnpm lint` actually runs.",
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"**/*.mts\"",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "//": "The e2e tree has no spec/app split, so unlike every other project this one points at its own tsconfig.json rather than a tsconfig.spec.json; the target default's command is overridden here for that reason alone.",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "storybook-e2e": {
      "//": "A separate browser lifecycle from the app E2E target: static Storybook needs no Synapse, and this target is intentionally uncached because its webServer builds component stories and theme files outside the e2e project input graph.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-playwright.mts --config=e2e/playwright.storybook.config.mts --build=components-storybook-host:build-storybook",
        "cwd": "{workspaceRoot}"
      }
    },
    "web-e2e": {
      "//": "Production Web/PWA startup, routing and offline checks against the exact shared www artifact. No Synapse or Docker is required.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-playwright.mts --config=e2e/playwright.web.config.mts --build=trinity:build:production",
        "cwd": "{workspaceRoot}"
      }
    },
    "phase7-e2e": {
      "//": "Shipped real-app semantic, responsive, contrast and geometry coverage. Serialized because it owns the fixed Synapse stack and deterministic accounts.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/run-phase7-e2e.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "styling-e2e": {
      "//": "A separate browser lifecycle from the Synapse-backed app journeys. It is intentionally uncached because its webServer builds application/theme files outside the e2e project input graph.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-playwright.mts --config=e2e/playwright.styling.config.mts --build=trinity:build:development",
        "cwd": "{workspaceRoot}"
      }
    },
    "scrollbars-e2e": {
      "//": "Focused Chromium, Firefox and WebKit scrollbar contract against the real app and disposable Synapse.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-playwright.mts --config=e2e/playwright.scrollbars.config.mts --build=trinity:build:development --resource=synapse",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-e2e": {
      "//": "Owns an installed API 36 WebView, a fixed-port Synapse stack, and adb reverse state. Those external resources are intentionally serialized and never cacheable.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node android/run.mts",
        "cwd": "{projectRoot}"
      }
    },
    "e2e-pr": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-pr"
      }
    },
    "e2e-all": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-all"
      }
    },
    "e2e-browser": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-browser"
      }
    },
    "e2e-components": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-components"
      }
    },
    "e2e-protocol": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-protocol"
      }
    },
    "e2e-electron": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-electron"
      }
    },
    "e2e-web": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-web"
      }
    },
    "e2e-android": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-android"
      }
    },
    "protocol-verify-sas": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/verify-sas-run.mjs"
      }
    },
    "protocol-verify-qr": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/verify-qr-run.mjs"
      }
    },
    "protocol-media": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/send-media-run.mjs"
      }
    },
    "protocol-threads": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/threads-run.mjs"
      }
    },
    "protocol-reply": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/reply-run.mjs"
      }
    },
    "protocol-spaces": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/spaces-run.mjs"
      }
    },
    "protocol-rooms": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/rooms-run.mjs"
      }
    },
    "protocol-search": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/search-run.mjs"
      }
    },
    "protocol-emoji": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build trinity --configuration=development && node e2e/runners/emoji-run.mjs"
      }
    },
    "protocol-verify-sas-selfcheck": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-feature.mts --feature=verify-sas-selfcheck --build=trinity:build:development"
      }
    },
    "protocol-crypto-spike-chromium": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-feature.mts --feature=crypto-spike --build=trinity:build:development --resource=crypto-spike -- chromium"
      }
    },
    "protocol-crypto-spike-webkit": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-feature.mts --feature=crypto-spike --build=trinity:build:development --resource=crypto-spike -- webkit"
      }
    },
    "protocol-login-smoke": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/run-feature.mts --feature=smoke-login --build=trinity:build:development"
      }
    },
    "synapse-up": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/synapse/start.mjs"
      }
    },
    "synapse-down": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/synapse/stop.mjs"
      }
    }
  }
}
