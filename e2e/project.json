{
  "name": "trinity-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e",
  "tags": ["type:e2e", "scope:trinity"],
  "implicitDependencies": ["trinity"],
  "targets": {
    "lint": {
      "//": "Declared, not inferred: @nx/eslint only infers a lint target for projects with .ts/.js sources, and every file here is .mts — so removing 'e2e' from globalIgnores would otherwise have changed nothing about what `pnpm lint` actually runs.",
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"**/*.mts\" --ignore-pattern \"browser/**\" --ignore-pattern \"components/**\" --ignore-pattern \"protocol/**\" --ignore-pattern \"support/**\" --ignore-pattern \"web/**\"",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "//": "The e2e tree has no spec/app split, so unlike every other project this one points at its own tsconfig.json rather than a tsconfig.spec.json; the target default's command is overridden here for that reason alone.",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "storybook-e2e": {
      "//": "Compatibility alias; lifecycle ownership is trinity-e2e-components:storybook.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run trinity-e2e-components:storybook",
        "cwd": "{workspaceRoot}"
      }
    },
    "web-e2e": {
      "//": "Compatibility alias; lifecycle ownership is trinity-e2e-web:production-pwa.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run trinity-e2e-web:production-pwa",
        "cwd": "{workspaceRoot}"
      }
    },
    "styling-e2e": {
      "//": "Compatibility alias; lifecycle ownership is trinity-e2e-components:styling.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run trinity-e2e-components:styling",
        "cwd": "{workspaceRoot}"
      }
    },
    "scrollbars-e2e": {
      "//": "Compatibility alias; lifecycle ownership is trinity-e2e-components:scrollbars.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run trinity-e2e-components:scrollbars",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-e2e": {
      "//": "Owns an installed API 36 WebView, a fixed-port Synapse stack, and adb reverse state. Those external resources are intentionally serialized and never cacheable.",
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node android/run.mts",
        "cwd": "{projectRoot}"
      }
    },
    "e2e-pr": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-pr"
      }
    },
    "e2e-all": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-all"
      }
    },
    "e2e-browser": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-browser"
      }
    },
    "e2e-components": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-components"
      }
    },
    "e2e-protocol": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-protocol"
      }
    },
    "e2e-electron": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-electron"
      }
    },
    "e2e-web": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-web"
      }
    },
    "e2e-android": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e-suite-registry.mjs run e2e-android"
      }
    },
    "synapse-up": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/synapse/start.mjs"
      }
    },
    "synapse-down": {
      "cache": false,
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/support/synapse/stop.mjs"
      }
    }
  }
}
