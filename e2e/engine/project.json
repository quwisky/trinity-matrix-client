{
  "name": "trinity-e2e-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e/engine",
  "tags": ["type:e2e", "scope:trinity", "environment:protocol"],
  "implicitDependencies": ["trinity-e2e-support"],
  "targets": {
    "contract": {
      "cache": false,
      "parallelism": false,
      "outputs": ["{workspaceRoot}/dist/.playwright/trinity-e2e-engine"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node e2e/engine/run.mts",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "rust": {
          "command": "node e2e/engine/run.mts --engine rust"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"**/*.{mjs,mts}\"",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.mts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest --config vitest.config.mts"
        }
      }
    }
  }
}
