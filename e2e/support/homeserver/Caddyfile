# TLS front for the e2e homeserver.
#
# Listens on https://localhost:8448 with Caddy's internal (self-signed) CA — the
# Playwright contexts launch with ignoreHTTPSErrors so the untrusted cert is fine.
#
#  - /.well-known/matrix/client is served inline so matrix-js-sdk AutoDiscovery
#    (https://localhost:8448/.well-known/matrix/client) resolves the homeserver to
#    THIS origin. base_url must be the externally reachable https URL, not the
#    container's http://homeserver:8008.
#  - Everything else proxies to the homeserver HTTP listener.
{
	# Quieter logs; internal CA so no ACME/public DNS needed.
	auto_https disable_redirects
}

https://localhost:8448 {
	tls internal

	header /.well-known/matrix/* Content-Type application/json
	header /.well-known/matrix/* Access-Control-Allow-Origin *

	respond /.well-known/matrix/client 200 {
		body `{"m.homeserver":{"base_url":"https://localhost:8448"}}`
	}

	respond /.well-known/matrix/server 200 {
		body `{"m.server":"localhost:8448"}`
	}

	# Default is the compose-network hostname. When the stack shares a job container's
	# network namespace there is no compose network and no DNS for it, but the homeserver is on
	# the same loopback — see docker-compose.netns.yml.
	reverse_proxy {$TRINITY_E2E_HOMESERVER_UPSTREAM:homeserver:8008}
}

# Internal default federation port for the primary server name `localhost`. The
# secondary homeserver uses this to retrieve the primary signing key and authenticate its
# requests. It is intentionally not published to the host.
https://localhost {
	tls internal
	reverse_proxy {$TRINITY_E2E_HOMESERVER_UPSTREAM:homeserver:8008}
}

# Federation front for the secondary homeserver. In the ordinary compose network its
# server name is caddy:9448; in netns CI it is localhost:9448. Serving both names keeps
# signatures and discovery correct in either topology.
https://caddy:9448, https://localhost:9448 {
	tls internal
	reverse_proxy {$TRINITY_E2E_REMOTE_HOMESERVER_UPSTREAM:localhost:8009}
}

# Plain-HTTP Open-Graph page for the link-preview e2e. The homeserver (on this docker
# network, with url previews enabled + an empty IP blacklist) fetches
# http://caddy:8080/og server-side and returns the OG metadata; the browser never
# touches it. Not exposed to the host — only reachable inside the trinity-e2e network.
:8080 {
	@og path /og
	header @og Content-Type "text/html; charset=utf-8"
	respond @og 200 {
		body `<!doctype html><html><head><meta property="og:title" content="Trinity E2E Preview"><meta property="og:description" content="A link preview served by the test harness."></head><body>ok</body></html>`
	}
}

# Opt-in MAS stack (TRINITY_E2E_MAS=1). mas/docker-compose.yml publishes these two ports and
# runs their upstreams; without it nothing reaches these sites. `route` keeps the order as
# written: the well-known answer first, MAS's compatibility endpoints next (as in a real
# MAS deployment), the delegating Synapse last.
https://localhost:8450 {
	tls internal
	@compat path_regexp ^/_matrix/client/[^/]+/(login|logout|refresh)$
	route {
		header /.well-known/matrix/* Content-Type application/json
		header /.well-known/matrix/* Access-Control-Allow-Origin *
		respond /.well-known/matrix/client `{"m.homeserver":{"base_url":"https://localhost:8450"}}` 200
		reverse_proxy @compat mas:8080
		reverse_proxy homeserver-mas:8008
	}
}

https://localhost:8451 {
	tls internal
	reverse_proxy mas:8080
}
