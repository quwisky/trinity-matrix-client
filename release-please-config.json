{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bootstrap-sha": "c2c47fce32d7dcb7789843d1638710dc0a860fac",
  "include-component-in-tag": false,
  "draft": true,
  "pull-request-title-pattern": "release: cut the v${version} release",
  "force-tag-creation": true,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Reverted"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "extra-files": [
    {
      "type": "json",
      "path": "electron/package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": ".release-please-manifest.next.json",
      "jsonpath": "$['.']"
    },
    {
      "type": "json",
      "path": "apps/docs-users/release.json",
      "jsonpath": "$.version"
    },
    {
      "type": "generic",
      "path": "apps/docs-users/src/content/docs/**/*.{md,mdx}",
      "glob": true
    }
  ],
  "packages": {
    ".": {}
  }
}
