    "electron:sign:dev": "node scripts/nx.mjs run trinity-desktop:sign-dev",
    "electron:e2e": "node scripts/nx.mjs run trinity-desktop:e2e",
    "electron:e2e:smoke": "node scripts/nx.mjs run trinity-desktop:e2e-smoke",
    "android:sync": "node scripts/nx.mjs run trinity-android:sync",
    "android:open": "node scripts/nx.mjs run trinity-android:open",
    "android:run": "node scripts/nx.mjs run trinity-android:run",
    "android:build": "node scripts/nx.mjs run trinity-android:build",
    "android:build:prebuilt": "node scripts/nx.mjs run trinity-android:build-prebuilt",
    "android:build:release": "node scripts/nx.mjs run trinity-android:build-release",
    "android:verify": "node scripts/nx.mjs run trinity-android:verify",
    "ios:sync": "node scripts/nx.mjs run trinity-ios:sync",
    "ios:open": "node scripts/nx.mjs run trinity-ios:open",
    "ios:run": "node scripts/nx.mjs run trinity-ios:run",
    "ios:build": "node scripts/nx.mjs run trinity-ios:build",
    "ios:verify": "node scripts/nx.mjs run trinity-ios:verify",
    "ios:build:prebuilt": "node scripts/nx.mjs run trinity-ios:build-prebuilt"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "//engines": "The `>= 26` half of this range was removed rather than gaining a CI leg: nothing has ever built, tested or packaged this workspace on Node 26, so the range was advertising support that no gate backed. Widening it again is a deliberate act — add the matrix leg first (the Electron job alone rebuilds a native binary), then the range.",
