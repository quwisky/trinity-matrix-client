    "e2e:protocol": "node scripts/nx.mjs run trinity-e2e:e2e-protocol",
    "e2e:electron": "node scripts/nx.mjs run trinity-e2e:e2e-electron",
    "e2e:web": "node scripts/nx.mjs run trinity-e2e:e2e-web",
    "e2e:verify": "node scripts/nx.mjs run trinity-e2e-protocol:verify-sas",
