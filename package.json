    "electron:build:prebuilt": "node scripts/nx.mjs run trinity-desktop:build-prebuilt",
    "electron:build:release": "node scripts/nx.mjs run trinity-desktop:build-release",
    "electron:start": "node scripts/nx.mjs run trinity-desktop:start",
    "electron:package": "node scripts/nx.mjs run trinity-desktop:package",
