{
  "name": "trinity",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "preinstall": "node -e \"if (!String(process.env.npm_config_user_agent).startsWith('pnpm')) { console.error('Use pnpm for this project — run: corepack enable && pnpm install'); process.exit(1); }\"",
    "prepare": "husky",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "start": "nx serve trinity",
    "build": "nx build trinity",
    "watch": "nx build trinity --watch --configuration development",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "stylelint": "stylelint \"{apps,libs}/**/*.scss\"",
    "spike:chromium": "nx build trinity && node e2e/crypto-spike.mjs chromium",
    "spike:webkit": "nx build trinity && node e2e/crypto-spike.mjs webkit",
    "smoke:login": "nx build trinity && node e2e/smoke-login.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "nx"
    ]
  },
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/angular": "^8.0.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.3.1",
    "dompurify": "^3.4.11",
    "ionicons": "^7.0.0",
    "marked": "^18.0.5",
    "matrix-js-sdk": "^41.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.2",
    "@analogjs/vitest-angular": "2.6.2",
    "@angular-devkit/build-angular": "20.3.28",
    "@angular/cli": "20.3.28",
    "@angular/compiler-cli": "20.3.25",
    "@angular/language-service": "20.3.25",
    "@capacitor/cli": "8.4.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-angular": "^21.1.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "@nx/angular": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/vite": "23.0.1",
    "@types/node": "^22.20.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.8",
    "nx": "23.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  },
  "description": "An Ionic project"
}
