{
  "name": "trinity",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "author": "quwisky <quwisky@qwky.eu>",
  "scripts": {
    "preinstall": "node -e \"if (!String(process.env.npm_config_user_agent).startsWith('pnpm')) { console.error('Use pnpm for this project — run: corepack enable && pnpm install'); process.exit(1); }\"",
    "prepare": "husky",
    "nx": "node scripts/nx.mjs",
    "format": "node scripts/nx.mjs format:write --all",
    "format:check": "node scripts/nx.mjs format:check --all",
    "architecture:check": "node scripts/architecture-contract.mjs check && node scripts/design-system-contract.mjs && node scripts/runtime-vendor-style-contract.mjs && node scripts/web-host-contract.mjs && node scripts/native-host-contract.mjs && node scripts/electron-host-contract.mjs && node scripts/e2e-suite-registry.mjs check",
    "architecture:map": "node scripts/architecture-contract.mjs write-map",
    "start": "node scripts/nx.mjs serve trinity",
    "build": "node scripts/nx.mjs build trinity",
    "watch": "node scripts/nx.mjs build trinity --watch --configuration development",
    "test": "node scripts/nx.mjs run-many -t test",
    "lint": "node scripts/nx.mjs run-many -t lint",
    "stylelint": "stylelint \"{apps,libs,e2e}/**/*.{scss,css}\"",
    "storybook": "node scripts/nx.mjs storybook components-storybook-host",
    "storybook:build": "node scripts/nx.mjs build-storybook components-storybook-host",
    "spike:chromium": "node scripts/nx.mjs run trinity-e2e-protocol:crypto-spike-chromium",
    "spike:webkit": "node scripts/nx.mjs run trinity-e2e-protocol:crypto-spike-webkit",
    "smoke:login": "node scripts/nx.mjs run trinity-e2e-protocol:login-smoke",
