{
  "name": "trinity",
  "version": "0.1.0",
  "author": "quwisky <quwisky@qwky.eu>",
  "scripts": {
    "preinstall": "node -e \"if (!String(process.env.npm_config_user_agent).startsWith('pnpm')) { console.error('Use pnpm for this project — run: corepack enable && pnpm install'); process.exit(1); }\"",
    "prepare": "husky",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "start": "nx serve trinity",
    "build": "nx build trinity",
    "watch": "nx build trinity --watch --configuration development",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "stylelint": "stylelint \"{apps,libs}/**/*.scss\"",
    "spike:chromium": "nx build trinity --configuration=development && node e2e/features/crypto-spike.mjs chromium",
    "spike:webkit": "nx build trinity --configuration=development && node e2e/features/crypto-spike.mjs webkit",
    "smoke:login": "nx build trinity --configuration=development && node e2e/features/smoke-login.mjs",
    "e2e:verify": "nx build trinity --configuration=development && node e2e/runners/verify-sas-run.mjs",
    "e2e:verify:up": "node e2e/synapse/start.mjs",
    "e2e:verify:down": "node e2e/synapse/stop.mjs",
    "e2e:media": "nx build trinity --configuration=development && node e2e/runners/send-media-run.mjs",
    "e2e:threads": "nx build trinity --configuration=development && node e2e/runners/threads-run.mjs",
    "e2e:reply": "nx build trinity --configuration=development && node e2e/runners/reply-run.mjs",
    "e2e:spaces": "nx build trinity --configuration=development && node e2e/runners/spaces-run.mjs",
    "e2e:rooms": "nx build trinity --configuration=development && node e2e/runners/rooms-run.mjs",
    "e2e:search": "nx build trinity --configuration=development && node e2e/runners/search-run.mjs",
    "e2e:emoji": "nx build trinity --configuration=development && node e2e/runners/emoji-run.mjs",
    "electron:install": "pnpm -C electron install",
    "electron:build": "pnpm run build && pnpm -C electron run build && pnpm run electron:sign:dev",
    "electron:start": "pnpm run electron:build && pnpm -C electron run start",
    "electron:package": "pnpm run electron:build && pnpm -C electron run package",
    "electron:package:mac": "pnpm run electron:build && pnpm -C electron run package:mac",
    "electron:package:mac:signed": "pnpm run electron:build && pnpm -C electron run package:mac:signed",
    "electron:package:linux": "pnpm run electron:build && pnpm -C electron run package:linux",
    "electron:package:win": "pnpm run electron:build && pnpm -C electron run package:win",
    "electron:package:all": "pnpm run electron:build && pnpm -C electron run package:all",
    "electron:sign:dev": "pnpm -C electron run sign:dev",
    "electron:e2e": "pnpm run electron:build && pnpm exec playwright test -c e2e/playwright.electron.config.mts",
    "android:sync": "pnpm run build && pnpm exec cap sync android",
    "android:open": "pnpm exec cap open android",
    "android:run": "pnpm run build && pnpm exec cap run android",
    "android:build": "pnpm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "pnpm run android:sync && cd android && ./gradlew bundleRelease",
    "ios:sync": "pnpm run build && pnpm exec cap sync ios",
    "ios:open": "pnpm exec cap open ios",
    "ios:run": "pnpm run build && pnpm exec cap run ios",
    "ios:build": "pnpm run ios:sync && pnpm exec cap build ios --scheme App"
  },
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@angular/cdk": "22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@angular/service-worker": "22.0.7",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-badge": "8.0.2",
    "@ctrl/ngx-emoji-mart": "^9.3.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.3.1",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/lucide": "^32.5.0",
    "@sanity/diff-match-patch": "^3.2.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "@spartan-ng/brain": "1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "luxon": "^3.7.2",
    "marked": "^18.0.6",
    "matrix-js-sdk": "^41.9.0",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-devkit/build-angular": "22.0.7",
    "@angular-devkit/core": "22.0.7",
    "@angular-devkit/schematics": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@capacitor/cli": "8.4.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/vite": "23.1.0",
    "@playwright/test": "^1.61.1",
    "@schematics/angular": "22.0.7",
    "@spartan-ng/cli": "1.1.0",
    "@swc/helpers": "~0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.20.1",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^17.0.8",
    "ng-mocks": "^14.15.3",
    "ng-packagr": "22.0.1",
    "nx": "23.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "description": "Trinity — a cross-platform Matrix client with end-to-end encryption (Angular, spartan.ng, Capacitor, Electron)"
}
