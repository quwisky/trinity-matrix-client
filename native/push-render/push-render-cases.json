      "event": null,
      "storedRoom": null,
      "stateRoomName": null,
      "senderName": null,
      "expected": {
        "title": "Trinity",
        "subtitle": "",
        "body": "Open Trinity to read this message"
      }
    },
    {
      "name": "an event that was read renders as usual even with the expired flag",
