    {
      "name": "encrypted event",
      "event": {
        "type": "m.room.encrypted",
        "sender": "@alice:hs",
        "content": {
          "algorithm": "m.megolm.v1.aes-sha2",
          "ciphertext": "AwgAEn"
        }
      },
      "storedRoom": {
        "name": "Secret",
        "direct": false,
        "encrypted": true
      },
      "stateRoomName": null,
      "senderName": "Alice",
      "expected": {
        "title": "Secret",
        "subtitle": "Alice",
        "body": "Encrypted message"
      }
    },
    {
      "name": "text sent in the clear into an encrypted room shows only the generic body",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.text",
          "body": "Your account is locked, sign in here"
        }
      },
      "storedRoom": {
        "name": "Bob",
        "direct": true,
        "encrypted": true
      },
      "stateRoomName": null,
      "senderName": "Bob",
      "expected": {
        "title": "Bob",
        "subtitle": "",
        "body": "New message"
      }
    },
    {
      "name": "sticker sent in the clear into an encrypted room shows only the generic body",
      "event": {
        "type": "m.sticker",
        "sender": "@alice:hs",
        "content": {
          "body": "cat",
          "url": "mxc://hs/cat"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": true
