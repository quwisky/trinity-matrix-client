{
  "version": 1,
  "cases": [
    {
      "name": "text message in a named room",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.text",
          "body": "  Hello there\n"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": false
      },
      "stateRoomName": null,
      "senderName": "Alice",
      "expected": {
        "title": "Team",
        "subtitle": "Alice",
        "body": "Hello there"
      }
    },
    {
      "name": "notice",
      "event": {
        "type": "m.room.message",
        "sender": "@bot:hs",
        "content": {
          "msgtype": "m.notice",
          "body": "Build passed"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": false
      },
      "stateRoomName": null,
      "senderName": "Build bot",
      "expected": {
        "title": "Team",
        "subtitle": "Build bot",
        "body": "Build passed"
      }
    },
    {
      "name": "emote",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.emote",
          "body": "waves"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": false
      },
      "stateRoomName": null,
      "senderName": "Alice",
      "expected": {
        "title": "Team",
        "subtitle": "Alice",
        "body": "* Alice waves"
      }
    },
    {
      "name": "emote from a member without a display name",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.emote",
          "body": "waves"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": false
      },
      "stateRoomName": null,
      "senderName": null,
      "expected": {
        "title": "Team",
        "subtitle": "@alice:hs",
        "body": "* @alice:hs waves"
      }
    },
    {
      "name": "formatted body is never parsed",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.text",
          "body": "plain words",
          "format": "org.matrix.custom.html",
          "formatted_body": "<b>bold words</b>"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false,
        "encrypted": false
      },
      "stateRoomName": null,
      "senderName": "Alice",
      "expected": {
        "title": "Team",
        "subtitle": "Alice",
        "body": "plain words"
      }
    },
    {
