      "stateRoomName": null,
      "senderName": "Alice",
      "expected": {
        "title": "Team",
        "subtitle": "Alice",
        "body": "New message"
      }
    },
    {
      "name": "a stored room without the encrypted flag counts as encrypted",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.text",
          "body": "hello"
        }
