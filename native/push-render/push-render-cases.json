    {
      "name": "body padded with next line and no-break space is trimmed",
      "event": {
        "type": "m.room.message",
        "sender": "@alice:hs",
        "content": {
          "msgtype": "m.text",
          "body": "\u0085\u00a0 padded \u00a0\u0085"
        }
      },
      "storedRoom": {
        "name": "Team",
        "direct": false
      },
      "stateRoomName": null,
