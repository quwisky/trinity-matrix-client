{
  "extends": "stylelint-config-standard-scss",
  "rules": {
    "selector-class-pattern": null,
    "custom-property-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$",
    "import-notation": null,
    "no-descending-specificity": null,
    "no-empty-source": null,
    "media-feature-range-notation": "prefix",
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": ["ng-deep"]
      }
    ],
    "scss/dollar-variable-pattern": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "source",
          "custom-variant",
          "theme",
          "utility",
          "variant",
          "apply",
          "plugin",
          "reference"
        ]
      }
    ],
    "nesting-selector-no-missing-scoping-root": null,
    "color-no-hex": true,
    "declaration-property-value-disallowed-list": {
      "/^(font-size|(padding|margin)(-(top|right|bottom|left|block|inline)(-(start|end))?)?|(row-|column-)?gap|border(-[a-z]+)*-radius)$/": [
        "/(?<![\\w$#.-])-?(\\d+(\\.\\d+)?|\\.\\d+)(px|rem|em|%|ex|ch|r?lh|[dsl]?v[hw]|vmin|vmax)(?![\\w-])/"
      ],
      "z-index": ["/^-?\\d+$/"]
    }
  },
  "overrides": [
    {
      "files": ["libs/theme-foundation/**"],
      "rules": {
        "color-no-hex": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
