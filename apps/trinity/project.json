{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "trinity",
  "projectType": "application",
  "sourceRoot": "apps/trinity/src",
  "prefix": "trn",
  "tags": ["type:app", "scope:trinity"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{workspaceRoot}/www"],
      "options": {
        "outputPath": {
          "base": "www",
          "browser": ""
        },
        "index": "apps/trinity/src/index.html",
        "browser": "apps/trinity/src/main.ts",
        "polyfills": ["apps/trinity/src/polyfills.ts"],
        "tsConfig": "apps/trinity/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/trinity/src/assets",
            "output": "assets"
          },
          {
            "glob": "matrix_sdk_crypto_wasm_bg.wasm",
            "input": "node_modules/@matrix-org/matrix-sdk-crypto-wasm/pkg",
            "output": "assets/crypto"
          }
        ],
        "styles": [
          "apps/trinity/src/global.scss",
          "apps/trinity/src/theme/variables.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/trinity/src/environments/environment.ts",
              "with": "apps/trinity/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "ci": {
          "progress": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "trinity:build:production"
        },
        "development": {
          "buildTarget": "trinity:build:development"
        },
        "ci": {
          "progress": false
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "trinity:build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/trinity"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    }
  }
}
