{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "trinity",
  "projectType": "application",
  "sourceRoot": "apps/trinity/src",
  "prefix": "trn",
  "tags": ["type:app", "scope:matrix", "role:app", "capability:composition"],
  "implicitDependencies": ["theme-foundation"],
  "targets": {
    "build-info": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/gen-build-info.mjs"
      }
    },
    "release-notes": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/gen-release-notes.mjs"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["build-info", "release-notes"],
      "//": "release-notes.ts is git-ignored, so the notes that scripts/gen-release-notes.mjs bundles reach the cache hash only through these variables.",
      "inputs": [
        "production",
        "^production",
        { "env": "TRINITY_RELEASE_NOTES_FIXTURE" },
        { "env": "TRINITY_RELEASE_NOTES" },
        { "env": "TRINITY_CURRENT_RELEASE_NOTES" }
      ],
      "outputs": ["{workspaceRoot}/www"],
      "options": {
        "outputPath": {
          "base": "www",
          "browser": ""
        },
        "index": "apps/trinity/src/index.html",
        "browser": "apps/trinity/src/main.ts",
        "tsConfig": "apps/trinity/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/trinity/src/assets",
            "output": "assets"
          },
          {
            "glob": "manifest.webmanifest",
            "input": "apps/trinity/src",
            "output": ""
          },
          {
            "glob": "matrix_sdk_crypto_wasm_bg.wasm",
            "input": "node_modules/@matrix-org/matrix-sdk-crypto-wasm/pkg",
            "output": "assets/crypto"
          }
        ],
        "styles": [
          "libs/theme-foundation/styles/theme.scss",
          "apps/trinity/src/vendor.css",
          "apps/trinity/src/global.scss",
          "apps/trinity/src/rendered-markdown.scss",
          {
            "input": "apps/trinity/src/katex.css",
            "inject": false,
            "bundleName": "katex"
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "another-json",
          "content-type",
          "events",
          "loglevel",
          "matrix-events-sdk",
          "matrix-widget-api",
          "sdp-transform",
          "unhomoglyph"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyScript",
              "maximumWarning": "3.75mb",
              "maximumError": "5mb"
            },
            {
              "type": "allScript",
              "maximumWarning": "7mb",
              "maximumError": "9mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/trinity/src/environments/environment.ts",
              "with": "apps/trinity/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "namedChunks": true,
          "serviceWorker": "apps/trinity/ngsw-config.json",
          "optimization": {
            "scripts": true,
            "fonts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "dependsOn": ["build-info", "release-notes"],
      "configurations": {
        "production": {
          "buildTarget": "trinity:build:production"
        },
        "development": {
          "buildTarget": "trinity:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {},
    "typecheck": {}
  }
}
