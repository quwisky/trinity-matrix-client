{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/katex.css",
          "!/maths-render-*.js",
          "!/config-editor.component-*.js"
        ]
      }
    },
    {
      "name": "maths",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/katex.css", "/maths-render-*.js"]
      }
    },
    {
      "name": "lazy-features",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/config-editor.component-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2|wasm)"
        ]
      }
    }
  ]
}
