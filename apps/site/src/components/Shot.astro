---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import desktop from '../placeholders/desktop.svg';
import phone from '../placeholders/phone.svg';

interface Props {
  scene: 'hero' | 'accounts' | 'encryption' | 'chat';
  viewport: 'desktop' | 'phone';
  alt: string;
  eager?: boolean;
}
const { scene, viewport, alt, eager = false } = Astro.props;

// Captured shots exist only when the release's screenshot set was downloaded before the build.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../../.generated/shots/*.png',
  { eager: true },
);
const shot = (theme: 'dark' | 'light') =>
  shots[`../../.generated/shots/${scene}-${viewport}-${theme}.png`]?.default;
const dark = shot('dark');
const light = shot('light');
const webp = (source: ImageMetadata) =>
  getImage({ src: source, format: 'webp', width: source.width, height: source.height });
const captured =
  dark && light ? { dark: await webp(dark), light: await webp(light), size: dark } : undefined;
const placeholder = viewport === 'desktop' ? desktop : phone;
const { width, height } = captured?.size ?? placeholder;
---

<picture class:list={['shot', viewport]}>
  {
    captured && (
      <>
        <source
          media="(prefers-color-scheme: dark)"
          srcset={captured.dark.src}
          type="image/webp"
        />
        <source
          media="(prefers-color-scheme: light)"
          srcset={captured.light.src}
          type="image/webp"
        />
      </>
    )
  }
  <img
    src={captured?.dark.src ?? placeholder.src}
    width={width}
    height={height}
    alt={captured ? alt : ''}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  /* Device frames: a window with a title bar for desktop shots, a bezel for phone shots. */
  .shot {
    display: block;
    overflow: hidden;
    box-shadow:
      0 2rem 4rem -2rem oklch(0% 0 0deg / 55%),
      0 0 0 1px var(--frame-edge);
  }

  .desktop {
    position: relative;
    padding-block-start: 1.75rem;
    border-radius: var(--radius);
    background: var(--frame);
  }

  /* The window's three controls. */
  .desktop::before {
    position: absolute;
    inset-block-start: 0.65rem;
    inset-inline-start: 0.85rem;
    inline-size: 2.6rem;
    block-size: 0.5rem;
    background:
      radial-gradient(circle closest-side, var(--frame-dot) 98%, transparent) 0 0 / 0.9rem 100%
      repeat-x;
    content: '';
  }

  .phone {
    padding: 0.45rem;
    border-radius: 2.25rem;
    background: var(--bezel);
  }

  .phone img {
    border-radius: 1.8rem;
  }
</style>
