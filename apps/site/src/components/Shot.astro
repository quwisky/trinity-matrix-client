---
import type { ImageMetadata } from 'astro';
import desktop from '../placeholders/desktop.svg';
import phone from '../placeholders/phone.svg';

interface Props {
  scene: 'hero' | 'accounts' | 'encryption' | 'chat';
  viewport: 'desktop' | 'phone';
  alt: string;
  eager?: boolean;
}
const { scene, viewport, alt, eager = false } = Astro.props;

// Captured shots exist only when the release's screenshot set was downloaded before the build.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../../.generated/shots/*.png',
  { eager: true },
);
const shot = (theme: 'dark' | 'light') =>
  shots[`../../.generated/shots/${scene}-${viewport}-${theme}.png`]?.default;
const dark = shot('dark');
const light = shot('light');
const image = (dark && light ? dark : undefined) ?? (viewport === 'desktop' ? desktop : phone);
---

<picture class:list={['shot', viewport]}>
  {
    dark && light && (
      <>
        <source media="(prefers-color-scheme: dark)" srcset={dark.src} />
        <source media="(prefers-color-scheme: light)" srcset={light.src} />
      </>
    )
  }
  <img
    src={image.src}
    width={image.width}
    height={image.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .shot img {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 1.5rem 3rem -1.5rem oklch(0% 0 0deg / 50%);
  }

  .phone img {
    border-radius: 1.5rem;
  }
</style>
