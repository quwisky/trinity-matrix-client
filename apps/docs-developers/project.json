{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs-developers",
  "projectType": "application",
  "root": "apps/docs-developers",
  "sourceRoot": "apps/docs-developers/src",
  "tags": ["type:tool", "scope:shared"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "{workspaceRoot}/apps/docs-developers"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "//": "The Markdown pipeline renders version references from these manifests.",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/electron/package.json"
      ],
      "outputs": ["{workspaceRoot}/dist/docs/developers"],
      "options": {
        "command": "astro build",
        "cwd": "{workspaceRoot}/apps/docs-developers"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro check",
        "cwd": "{workspaceRoot}/apps/docs-developers"
      }
    }
  }
}
