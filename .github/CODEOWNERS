/electron/package.json @quwisky
/electron/pnpm-lock.yaml @quwisky
/electron/pnpm-workspace.yaml @quwisky
/electron/electron-builder.config.ts @quwisky
/electron/electron-builder.yml @quwisky
/electron/electron-builder.next.yml @quwisky
/electron/afterPack.cjs @quwisky
/electron/build/ @quwisky
/electron/src/release-channel.ts @quwisky
