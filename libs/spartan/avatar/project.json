{
  "name": "avatar",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/spartan/avatar/src",
  "prefix": "hlm",
  "projectType": "library",
  "tags": ["type:ui", "scope:trinity"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/spartan/avatar/ng-package.json",
        "tsConfig": "libs/spartan/avatar/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/spartan/avatar/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
