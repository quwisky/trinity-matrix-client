{
  "name": "sonner",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/kit/sonner/src",
  "prefix": "trn",
  "projectType": "library",
  "tags": ["type:ui", "scope:shared", "ui:vendor-wrapper"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/kit/sonner/ng-package.json",
        "tsConfig": "libs/kit/sonner/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/kit/sonner/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    }
  }
}
