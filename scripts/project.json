{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "scripts",
  "projectType": "library",
  "sourceRoot": "scripts",
  "tags": ["type:tool", "scope:shared"],
  "targets": {
    "test": {
      "//": "These cross-cutting guards inspect the entire source tree and, for repository-media-policy, the Git index itself. Nx cannot model that index as an input, so caching this target could replay a pass after a forbidden tracked file is added.",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/**/*.ts",
        "{workspaceRoot}/apps/**/*.html",
        "{workspaceRoot}/apps/**/*.scss",
        "{workspaceRoot}/apps/**/*.css",
        "{workspaceRoot}/apps/**/*.md",
        "{workspaceRoot}/apps/docs-*/**/*.json",
        "{workspaceRoot}/apps/docs-*/**/*.mjs",
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/architecture/*.json",
        "{workspaceRoot}/CONTEXT.md",
        "{workspaceRoot}/docs/**/*.md",
        "{workspaceRoot}/docs-internal/**/*.md",
        "{workspaceRoot}/libs/**/*.ts",
        "{workspaceRoot}/libs/**/*.html",
        "{workspaceRoot}/libs/**/*.scss",
        "{workspaceRoot}/libs/**/*.css",
        "{workspaceRoot}/libs/**/*.md",
        "{workspaceRoot}/libs/**/project.json",
        "{workspaceRoot}/ios/**/*.swift",
        "{workspaceRoot}/android/project.json",
        "{workspaceRoot}/electron/project.json",
        "{workspaceRoot}/e2e/project.json",
        "{workspaceRoot}/e2e/**/*.mts",
        "{workspaceRoot}/e2e/**/*.mjs",
        "{workspaceRoot}/e2e/**/*.ts",
        "{workspaceRoot}/e2e/**/*.js",
        "{workspaceRoot}/e2e/**/*.md",
        "{workspaceRoot}/e2e/**/*-snapshots/**/*",
        "{workspaceRoot}/docs/evidence/**/*",
        "{workspaceRoot}/**/*.{gif,jpeg,jpg,png,webp}",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tools/docs/**/*",
        "{workspaceRoot}/.github/workflows/*.yml",
        "{workspaceRoot}/.github/actions/**/*.yml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/ios/project.json",
        "{workspaceRoot}/container/**",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/electron/package.json"
      ]
    },
    "record-renderer": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/renderer-artifact.mjs record",
        "cwd": "{workspaceRoot}"
      }
    },
    "verify-renderer": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/web-bundle-manifest.mjs verify dist/web-bundle-manifest.json www",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
