{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "lib": ["es2018", "dom"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "@trinity/util-matrix": ["libs/util-matrix/src/index.ts"],
      "@trinity/platform-native": ["libs/platform-native/src/index.ts"],
      "@trinity/data-access-matrix-client": [
        "libs/data-access-matrix-client/src/index.ts"
      ],
      "@trinity/data-access-auth": ["libs/data-access-auth/src/index.ts"],
      "@trinity/data-access-notifications": [
        "libs/data-access-notifications/src/index.ts"
      ],
      "@trinity/data-access-search": ["libs/data-access-search/src/index.ts"],
      "@trinity/data-access-pinned": ["libs/data-access-pinned/src/index.ts"],
      "@trinity/data-access-invites": ["libs/data-access-invites/src/index.ts"],
      "@trinity/data-access-profile": ["libs/data-access-profile/src/index.ts"],
      "@trinity/data-access-crypto": ["libs/data-access-crypto/src/index.ts"],
      "@trinity/data-access-timeline": [
        "libs/data-access-timeline/src/index.ts"
      ],
      "@trinity/data-access-rooms": ["libs/data-access-rooms/src/index.ts"],
      "@trinity/data-access-media": ["libs/data-access-media/src/index.ts"],
      "@trinity/data-access-gif": ["libs/data-access-gif/src/index.ts"],
      "@trinity/feature-auth": ["libs/feature-auth/src/index.ts"],
      "@trinity/feature-crypto": ["libs/feature-crypto/src/index.ts"],
      "@trinity/feature-rooms": ["libs/feature-rooms/src/index.ts"],
      "@trinity/feature-settings": ["libs/feature-settings/src/index.ts"],
      "@trinity/ui": ["libs/ui/src/index.ts"],
      "@trinity/feature-shell": ["libs/feature-shell/src/index.ts"],
      "@trinity/feature-shell/home-page": [
        "libs/feature-shell/src/lib/home.page.ts"
      ],
      "@trinity/helm/button": ["./libs/spartan/button/src/index.ts"],
      "@trinity/helm/utils": ["./libs/spartan/utils/src/index.ts"],
      "@trinity/helm/input": ["./libs/spartan/input/src/index.ts"],
      "@trinity/helm/label": ["./libs/spartan/label/src/index.ts"],
      "@trinity/helm/badge": ["./libs/spartan/badge/src/index.ts"],
      "@trinity/helm/checkbox": ["./libs/spartan/checkbox/src/index.ts"],
      "@trinity/helm/radio-group": ["./libs/spartan/radio-group/src/index.ts"],
      "@trinity/helm/progress": ["./libs/spartan/progress/src/index.ts"],
      "@trinity/helm/spinner": ["./libs/spartan/spinner/src/index.ts"],
      "@trinity/helm/sonner": ["./libs/spartan/sonner/src/index.ts"],
      "@trinity/helm/overlay": ["./libs/spartan/overlay/src/index.ts"],
      "@trinity/helm/tooltip": ["./libs/spartan/tooltip/src/index.ts"],
      "@trinity/helm/dropdown-menu": [
        "./libs/spartan/dropdown-menu/src/index.ts"
      ],
      "@trinity/helm/avatar": ["./libs/spartan/avatar/src/index.ts"],
      "@trinity/helm/textarea": ["./libs/spartan/textarea/src/index.ts"],
      "@trinity/helm/card": ["./libs/spartan/card/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
