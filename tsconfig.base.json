{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "lib": ["es2018", "dom"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "@trinity/core": ["libs/core/src/index.ts"],
      "@trinity/feature-auth": ["libs/feature-auth/src/index.ts"],
      "@trinity/feature-crypto": ["libs/feature-crypto/src/index.ts"],
      "@trinity/feature-rooms": ["libs/feature-rooms/src/index.ts"],
      "@trinity/feature-settings": ["libs/feature-settings/src/index.ts"],
      "@trinity/ui": ["libs/ui/src/index.ts"],
      "@trinity/helm/button": ["./libs/spartan/button/src/index.ts"],
      "@trinity/helm/utils": ["./libs/spartan/utils/src/index.ts"],
      "@trinity/helm/input": ["./libs/spartan/input/src/index.ts"],
      "@trinity/helm/label": ["./libs/spartan/label/src/index.ts"],
      "@trinity/helm/badge": ["./libs/spartan/badge/src/index.ts"],
      "@trinity/helm/checkbox": ["./libs/spartan/checkbox/src/index.ts"],
      "@trinity/helm/radio-group": ["./libs/spartan/radio-group/src/index.ts"],
      "@trinity/helm/progress": ["./libs/spartan/progress/src/index.ts"],
      "@trinity/helm/spinner": ["./libs/spartan/spinner/src/index.ts"],
      "@trinity/helm/sonner": ["./libs/spartan/sonner/src/index.ts"],
      "@trinity/helm/overlay": ["./libs/spartan/overlay/src/index.ts"],
      "@trinity/helm/tooltip": ["./libs/spartan/tooltip/src/index.ts"],
      "@trinity/helm/dropdown-menu": [
        "./libs/spartan/dropdown-menu/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
