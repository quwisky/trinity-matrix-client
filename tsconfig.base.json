{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "@trinity/util/matrix": ["./libs/util/matrix/src/index.ts"],
      "@trinity/util/matrix/code-highlight": [
        "./libs/util/matrix/src/lib/code-highlight.ts"
      ],
      "@trinity/testing": ["./libs/testing/src/index.ts"],
      "@trinity/platform-native": ["./libs/platform-native/src/index.ts"],
      "@trinity/data-access/matrix-client": [
        "./libs/data-access/matrix-client/src/index.ts"
      ],
      "@trinity/data-access/auth": ["./libs/data-access/auth/src/index.ts"],
      "@trinity/data-access/notifications": [
        "./libs/data-access/notifications/src/index.ts"
      ],
      "@trinity/data-access/search": ["./libs/data-access/search/src/index.ts"],
      "@trinity/data-access/pinned": ["./libs/data-access/pinned/src/index.ts"],
      "@trinity/data-access/invites": [
        "./libs/data-access/invites/src/index.ts"
      ],
      "@trinity/data-access/profile": [
        "./libs/data-access/profile/src/index.ts"
      ],
      "@trinity/data-access/crypto": ["./libs/data-access/crypto/src/index.ts"],
      "@trinity/data-access/timeline": [
        "./libs/data-access/timeline/src/index.ts"
      ],
      "@trinity/data-access/rooms": ["./libs/data-access/rooms/src/index.ts"],
      "@trinity/data-access/media": ["./libs/data-access/media/src/index.ts"],
      "@trinity/data-access/gif": ["./libs/data-access/gif/src/index.ts"],
      "@trinity/feature/auth": ["./libs/feature/auth/src/index.ts"],
      "@trinity/feature/crypto": ["./libs/feature/crypto/src/index.ts"],
      "@trinity/feature/rooms": ["./libs/feature/rooms/src/index.ts"],
      "@trinity/feature/settings": ["./libs/feature/settings/src/index.ts"],
      "@trinity/ui": ["./libs/ui/src/index.ts"],
      "@trinity/feature/shell": ["./libs/feature/shell/src/index.ts"],
      "@trinity/feature/shell/home-page": [
        "./libs/feature/shell/src/lib/home.page.ts"
      ],
      "@trinity/kit/button": ["./libs/kit/button/src/index.ts"],
      "@trinity/kit/utils": ["./libs/kit/utils/src/index.ts"],
      "@trinity/kit/input": ["./libs/kit/input/src/index.ts"],
      "@trinity/kit/label": ["./libs/kit/label/src/index.ts"],
      "@trinity/kit/badge": ["./libs/kit/badge/src/index.ts"],
      "@trinity/kit/checkbox": ["./libs/kit/checkbox/src/index.ts"],
      "@trinity/kit/radio-group": ["./libs/kit/radio-group/src/index.ts"],
      "@trinity/kit/progress": ["./libs/kit/progress/src/index.ts"],
      "@trinity/kit/spinner": ["./libs/kit/spinner/src/index.ts"],
      "@trinity/kit/sonner": ["./libs/kit/sonner/src/index.ts"],
      "@trinity/kit/overlay": ["./libs/kit/overlay/src/index.ts"],
      "@trinity/kit/tooltip": ["./libs/kit/tooltip/src/index.ts"],
      "@trinity/kit/dropdown-menu": ["./libs/kit/dropdown-menu/src/index.ts"],
      "@trinity/kit/avatar": ["./libs/kit/avatar/src/index.ts"],
      "@trinity/kit/textarea": ["./libs/kit/textarea/src/index.ts"],
      "@trinity/kit/card": ["./libs/kit/card/src/index.ts"],
      "@trinity/kit/select": ["./libs/kit/select/src/index.ts"],
      "@trinity/kit/icon": ["./libs/kit/icon/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
