      "@trinity/helm/card": ["./libs/spartan/card/src/index.ts"],
      "@trinity/helm/select": ["./libs/spartan/select/src/index.ts"],
      "@trinity/components/overlay": ["./libs/components/overlay/src/index.ts"],
      "@trinity/helm/toggle-group": [
        "./libs/spartan/toggle-group/src/index.ts"
      ],
      "@trinity/helm/toggle": ["./libs/spartan/toggle/src/index.ts"],
      "@trinity/helm/separator": ["./libs/spartan/separator/src/index.ts"],
      "@trinity/helm/tabs": ["./libs/spartan/tabs/src/index.ts"],
      "@trinity/helm/switch": ["./libs/spartan/switch/src/index.ts"],
      "@trinity/data-access/widgets": [
        "./libs/data-access/widgets/src/index.ts"
      ],
      "@trinity/data-access/accounts": [
        "./libs/data-access/accounts/src/index.ts"
      ],
      "@trinity/runtime/projection": ["./libs/runtime/projection/src/index.ts"],
      "@trinity/application/workspace": [
        "./libs/application/workspace/src/index.ts"
      ],
      "@trinity/application/runtime": [
        "./libs/application/runtime/src/index.ts"
      ],
      "@trinity/application/appearance": [
        "./libs/application/appearance/src/index.ts"
      ],
      "@trinity/application/badge": ["./libs/application/badge/src/index.ts"],
      "@trinity/runtime/host": ["./libs/runtime/host/src/index.ts"],
      "@trinity/data-access/room-administration": [
        "./libs/data-access/room-administration/src/index.ts"
      ],
      "@trinity/application/search": ["./libs/application/search/src/index.ts"],
      "@trinity/components/foundations": [
        "./libs/components/foundations/src/index.ts"
      ],
      "@trinity/components/controls": [
        "./libs/components/controls/src/index.ts"
      ],
      "@trinity/components/navigation-layout": [
        "./libs/components/navigation-layout/src/index.ts"
      ],
      "@trinity/components/generic-content": [
        "./libs/components/generic-content/src/index.ts"
      ],
      "@trinity/theme-foundation": ["./libs/theme-foundation/src/index.ts"],
      "@trinity/docs/*": ["./tools/docs/*"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
