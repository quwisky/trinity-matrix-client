<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No backup and no device-to-device transfer: the app's data belongs to this
         device's Matrix sessions (see res/xml/data_extraction_rules.xml). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App deep links. Room links: dev.trinityproject.trinity://matrix.to/#/<room id or alias>
                 (see parseTrinityRoomLink). Auth callback links, two shapes that must match:
                   legacy SSO: dev.trinityproject.trinity://sso-callback?loginToken=…
                   OIDC:       dev.trinityproject.trinity:/sso-callback?code=…
                 The OIDC form follows RFC 8252 §7.1 (private-use scheme, no
                 authority), so it has no host for android:host to match against —
                 hence a scheme-only filter. TrinityApplicationSessionAdapter.handleDeepLink()
                 validates every link before acting on anything that arrives. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.trinityproject.trinity" />
            </intent-filter>

        </activity>

        <!-- Route FCM notifications to the "messages" channel created at runtime
             by PushService (Android O+ drops notifications without a channel). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_trinity" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />

        <!-- Device-rendered push: TrinityMessagingService replaces the push plugin's
             MessagingService, keeping its foreground behaviour and token callbacks, and
             renders closed-app pushes from the push handoff store. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".push.TrinityMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Take photo / Record video (#919): Android 11+ package visibility hides the camera app
         from the capture intents unless they are declared. The camera plugin's own manifest
         declares IMAGE_CAPTURE only; both are listed here so the host owns the pair. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- @capacitor/push-notifications: runtime notification permission (Android 13+).
         The plugin's own manifest does not declare it, so the OS would deny without
         a prompt unless it's here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- @capacitor/camera: take photos, record videos and pick from the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Composer voice messages and location sharing use the corresponding Web APIs
         inside the Capacitor WebView, whose runtime grants still require manifest entries. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
