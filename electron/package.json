{
  "name": "trinity-desktop",
  "productName": "Trinity",
  "version": "0.7.0-next.0",
  "license": "MIT",
  "private": true,
  "description": "End-to-end encrypted Matrix client",
  "author": "Trinity",
  "nx": {
    "includedScripts": []
  },
  "//homepage": "Required metadata, not decoration: the Linux `deb` target fails the whole build without it (fpm needs a package URL). It also becomes the NuGet projectUrl on Windows.",
  "homepage": "https://github.com/quwisky/trinity-matrix-client",
  "main": "dist/main.js",
  "scripts": {
    "ensure:binary": "node scripts/ensure-electron.mjs",
    "copy:www": "node scripts/copy-www.mjs",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/copy-www.mjs && tsc -p tsconfig.json",
    "build:windows-hello": "node scripts/build-windows-hello.mjs",
    "test": "vitest run",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.ts --mac && codesign --force --deep --sign \"trinity-dev\" release/mac-arm64/*.app",
    "package:mac:signed": "electron-builder --config electron-builder.config.ts --mac",
    "package:linux": "electron-builder --config electron-builder.config.ts --linux",
    "package:win": "electron-builder --config electron-builder.config.ts --win",
    "package:all": "electron-builder --config electron-builder.config.ts --mac --linux --win",
    "sign:dev": "node -e \"if (process.platform !== 'darwin') { console.log('sign:dev: skipped, not macOS'); process.exit(0); } require('node:child_process').execFileSync('codesign', ['--force','--deep','--sign','trinity-dev','node_modules/electron/dist/Electron.app'], { stdio: 'inherit' });\""
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.13.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "node-gyp": "13.1.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
